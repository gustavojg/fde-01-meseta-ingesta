{
  "name": "meseta-ingesta",
  "version": "0.1.0",
  "private": true,
  "description": "Order ingestion from Excel and email into the ERP of Transportes Meseta (FDE course, assignment 01)",
  "license": "MIT",
  "author": "Gustavo",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:acceptance": "vitest run test/acceptance --passWithNoTests",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
