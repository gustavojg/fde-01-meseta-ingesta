# Copy to .env and fill in. Never commit .env.
# Copiar a .env y rellenar. Nunca subir .env al repositorio.

# --- General ---
APP_ENV=dev                 # dev | staging | prod
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
DRY_RUN=true                # true: validate and log, do not write to the ERP

# --- Excel source / Origen Excel ---
EXCEL_INBOX_DIR=./inbox     # folder watched for incoming .xlsx order files
EXCEL_PROCESSED_DIR=./outbox/processed
EXCEL_REJECTED_DIR=./outbox/rejected

# --- Email source (IMAP) / Origen email ---
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=pedidos@example.com
IMAP_PASSWORD=change-me
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=60

# --- ERP target / Destino ERP ---
ERP_BASE_URL=https://erp.example.com/api
ERP_API_KEY=change-me
ERP_TIMEOUT_SECONDS=30

# --- Review queue / Cola de revisión manual ---
REVIEW_NOTIFY_EMAIL=operaciones@example.com
